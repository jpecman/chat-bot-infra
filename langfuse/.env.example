# Copy to .env and fill in. Generate secrets with the commands shown.

# URL you open Langfuse at from your browser (the Ubuntu machine's host/IP).
NEXTAUTH_URL=http://ubuntu-box:3000

# openssl rand -base64 32
NEXTAUTH_SECRET=
# openssl rand -base64 32
SALT=
# openssl rand -hex 32  (must be 64 hex characters)
ENCRYPTION_KEY=

# Internal service passwords (openssl rand -hex 24). Hex avoids characters
# that would break the Postgres connection URL or the Redis command line.
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# Optional
# LANGFUSE_BIND_ADDR=0.0.0.0
# LANGFUSE_PORT=3000
# TELEMETRY_ENABLED=false
